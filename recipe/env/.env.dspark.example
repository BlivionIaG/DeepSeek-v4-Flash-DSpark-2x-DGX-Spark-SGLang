# .env.dspark.example — operator-side configuration for the SGLang TP=2 recipe.
#
# Copy to .env.dspark on EACH host (or one shared copy that's rsynced
# from head to worker) and edit the values for your network. Every
# field has a default baked into recipe/scripts/start-tp2.sh; this file
# is for overrides + audit-trail documentation.
#
# DO NOT commit your actual .env.dspark — it contains at most the LAN
# IPs of your two sparks, but it's per-deployment and not shareable.

# ─────────────────────────────────────────────────────────────────
# Docker image
# ─────────────────────────────────────────────────────────────────

# Republished patch of upstream lmsysorg/sglang:dev-v4f-2dgx-v2 with
# two source-level patches (see README.md "The patches" section).
# Published to Docker Hub so the recipe is one-line reproducible for
# anyone with a 2× DGX Spark pair — no local image build required.
#
#   docker.io/blivioniag/sglang:dev-v4f-2dgx-v2-patched-v3_patch001
#     = lmsysorg/sglang:dev-v4f-2dgx-v2
#       + deepseek_v4.py  (skip aligner.* / dspark_aligner.* weights)
#       + offloader.py    (tie_weights=False on functional_call)
#
# The image is PRIVATE on Docker Hub (default for new packages).
# One-time setup per host:
#   sudo docker login docker.io -u blivioniag
# (Use a Docker Hub access token, not your password — see
# https://hub.docker.com/settings/security)
#
# Then start-tp2.sh auto-pulls on first run.
SGLANG_IMAGE=docker.io/blivioniag/sglang:dev-v4f-2dgx-v2-patched-v3_patch001

# ─────────────────────────────────────────────────────────────────
# Model
# ─────────────────────────────────────────────────────────────────

# Path on disk to the local HF snapshot. Must be identical on both
# sparks (157 GiB; rsync from head to worker).
SGLANG_MODEL_PATH=/root/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4-Flash-Vision-Exp/snapshots/86f746b36186f0e567729a5c06a8c918caba82a9

# ─────────────────────────────────────────────────────────────────
# Serving profile
# ─────────────────────────────────────────────────────────────────

# TP=2 across both nodes. NO --ep-size (deepep metadata init fails on
# this preview image).
# Both flags are passed to `sglang serve` on both nodes; the head
# additionally gets --host + --port, the worker gets neither (headless).
SGLANG_MEM_FRACTION_STATIC=0.85          # KV cache + activation budget per rank
SGLANG_MAX_RUNNING_REQUESTS=8            # per-rank concurrent requests
SGLANG_CONTEXT_LENGTH=4096               # conservative; lift to 32k+ once CUDA-graph profiling hotfix lands upstream

# ─────────────────────────────────────────────────────────────────
# DeepSeek V4 chat-template features
# ─────────────────────────────────────────────────────────────────
# All three are REQUIRED for opencode-style agent loops to work
# (tool calls + reasoning + DSpark speculative decoding). Per the
# DeepSeek V4 README. Set any to "" to disable.
#   --tool-call-parser deepseekv4
#     Parses <tool_call>...</tool_call> blocks into OpenAI-format
#     tool_calls. Without this, every "tool call" lands as plain text.
#     (No separate --enable-auto-tool-choice needed — that's vLLM-only.)
#   --reasoning-parser deepseek-v4
#     Strips <think>...</think> into the OpenAI `reasoning` field.
#   --speculative-algorithm DSPARK
#     DSpark uses the same checkpoint for target + draft (no separate
#     draft model path); roughly doubles decode tokens/s.
SGLANG_TOOL_CALL_PARSER=deepseekv4
SGLANG_REASONING_PARSER=deepseek-v4
SGLANG_SPECULATIVE_ALGORITHM=DSPARK

# ─────────────────────────────────────────────────────────────────
# ConnectX / NCCL
# ─────────────────────────────────────────────────────────────────

# Dual ACTIVE HCAs (closed 2026-09-05). Both controllers IP-bound so
# NCCL_RDMAV2 can use them:
#   enp1s0f1np1   (rocep1s0f1)    → 10.0.22.1/24 (head) / .2/24 (worker)
#   enP2p1s0f1np1 (roceP2p1s0f1)  → 10.0.23.1/24 (head) / .2/24 (worker)
# start-tp2.sh auto-binds the second subnet via NetworkManager if it's
# missing (idempotent; safe to re-run). Both at MTU 9000.
SGLANG_DIST_INIT_ADDR=10.0.22.1:29500    # head's primary ConnectX IP:port
SGLANG_DIST_TIMEOUT=1800                  # NCCL handshake timeout (s)

# ─────────────────────────────────────────────────────────────────
# Head-only
# ─────────────────────────────────────────────────────────────────

SGLANG_SERVING_PORT=8888                 # head's public OpenAI-compatible port

# ─────────────────────────────────────────────────────────────────
# NCCL envs (exported by start-tp2.sh; documented here for visibility)
# ─────────────────────────────────────────────────────────────────
#
# NCCL_IB_DISABLE=0
# NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
# NCCL_IB_GID_INDEX=3
# NCCL_SOCKET_IFNAME=enp1s0f1np1
# GLOO_SOCKET_IFNAME=enp1s0f1np1
# TP_SOCKET_IFNAME=enp1s0f1np1
# NCCL_IGNORE_CPU_AFFINITY=1
# SGLANG_SM120_FLASHMLA_BACKEND=b12x       # b12x FlashMLA backend for sm120/Blackwell GB10
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
